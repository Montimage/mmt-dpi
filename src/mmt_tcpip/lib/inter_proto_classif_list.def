/*
 * inter_proto_classif_list.def — the single source of truth for the
 * inter-protocol classifier registrations run by init_tcpip_plugin()
 * (issue #238, F-CLEAN-006).
 *
 * One MMT_INTER_PROTO(parent_proto, classify_fn, weight, excluded_proto)
 * entry per registered classifier, expanded once in configured_protocols.c
 * into the inter_proto_table[] rows that the init loop walks.
 * excluded_proto (issue #560) is the protocol id the checker's translation
 * unit passes as the last argument of its mmt_init_classify_bitmasks*() call
 * — the id its excluded bitmask holds — or PROTO_UNKNOWN for a checker
 * without that guard (mmt_check_http2). init_tcpip_plugin() stores it, with
 * the selection mask that call recorded, in the checker's chain node, from
 * which the frozen chain entry copies it (docs/DECISIONS.md, 2026-10-31).
 *
 * ORDER IS SIGNIFICANT — registration order decides classifier chain
 * order and therefore classification results; the weight groups below
 * (20 highest priority .. 60 special projects) document the historical
 * grouping. Append new classifiers at the end of their group; do not
 * sort this file.
 *
 * MMT_INTER_PROTO_LEGACY(parent_proto, classify_fn, weight, excluded_proto) rows (issue
 * #540, F-BUG-311) are the 38 registrations (35 checkers) of defunct
 * services: they keep their place in the chain but are skipped unless the
 * handler runs the opt-in `legacy` DPI profile (docs/DPI-Profiles.md), so
 * the default chains no longer run them on every unknown flow. A classifier is legacy only when its
 * service or client protocol is unequivocally retired; the list and
 * the criterion are recorded in docs/DECISIONS.md (2026-10-29, #540).
 *
 * This file is intentionally not `#pragma once` / include-guarded: it is
 * meant to be included with MMT_INTER_PROTO and MMT_INTER_PROTO_LEGACY
 * defined by the includer.
 */

    /* CLASSIFY PROTOCOL OVER TCP PROTOCOL */
    /* WEIGHT: 20 = highest priority, 30 = popular, 40 = less popular,
     * 50 = rare, 60 = special projects (NDN) */
    MMT_INTER_PROTO(PROTO_TCP, mmt_check_http2, 9, PROTO_UNKNOWN)
    MMT_INTER_PROTO(PROTO_TCP, mmt_check_http, 20, PROTO_HTTP)
    MMT_INTER_PROTO(PROTO_TCP, mmt_check_ssl, 20, PROTO_SSL)

