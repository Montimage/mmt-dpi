/*
 * inter_proto_classif_list.def — the single source of truth for the
 * inter-protocol classifier registrations run by init_tcpip_plugin()
 * (issue #238, F-CLEAN-006).
 *
 * One MMT_INTER_PROTO(parent_proto, classify_fn, weight) entry per
 * registered classifier, expanded once in configured_protocols.c into
 * the inter_proto_table[] rows that the init loop walks.
 *
 * ORDER IS SIGNIFICANT — registration order decides classifier chain
 * order and therefore classification results; the weight groups below
 * (20 highest priority .. 60 special projects) document the historical
 * grouping. Append new classifiers at the end of their group; do not
 * sort this file.
 *
 * This file is intentionally not `#pragma once` / include-guarded: it is
 * meant to be included with MMT_INTER_PROTO defined by the includer.
 */

    /* CLASSIFY PROTOCOL OVER TCP PROTOCOL */
    /* WEIGHT: 20 = highest priority, 30 = popular, 40 = less popular,
     * 50 = rare, 60 = special projects (NDN) */
    MMT_INTER_PROTO(PROTO_TCP, mmt_check_http2, 9)
    MMT_INTER_PROTO(PROTO_TCP, mmt_check_http, 20)
    MMT_INTER_PROTO(PROTO_TCP, mmt_check_ssl, 20)

    MMT_INTER_PROTO(PROTO_TCP, mmt_check_dns, 30)
