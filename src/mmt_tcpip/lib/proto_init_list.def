/*
 * proto_init_list.def — the single source of truth for TCP/IP plugin protocol
 * registration (issue #148, F-DEAD-002).
 *
 * One entry per protocol, in one of two row forms:
 *
 *   MMT_PROTO_INIT(init_function, "display_name")
 *       a protocol with its own source file under protocols/, whose
 *       init_function registers attributes, classifiers or session context.
 *   MMT_PROTO_SIMPLE(PROTO_ID, PROTO_ID_ALIAS, "display_name")
 *       a registration-only protocol (issue #542, F-CLEAN-012): no source
 *       file; init_tcpip_plugin() registers PROTO_ID under PROTO_ID_ALIAS
 *       itself — exactly what the 506 deleted 20-line proto_*.c stubs did.
 *
 * The list is included twice, with both macros defined differently each time:
 *
 *   mmt_common_internal_include.h   emits the init function declarations
 *                                   (MMT_PROTO_SIMPLE rows emit nothing)
 *   configured_protocols.c          emits the proto_init_table[] rows
 *
 * Adding a registration-only protocol is one MMT_PROTO_SIMPLE line here; one
 * with its own logic is its source file plus one MMT_PROTO_INIT line. Before
 * this list existed the declarations
 * and the registration table were maintained separately and had already
 * drifted apart (a duplicated zone_telechargement declaration carrying a
 * doubled `proto_` prefix, plus declarations for two FTP init functions that
 * no translation unit ever defined).
 *
 * ORDER IS SIGNIFICANT — registration order decides classifier chain order and
 * therefore classification results. Append new protocols at the end; do not
 * sort this file.
 *
 * This file is intentionally not `#pragma once` / include-guarded: it is meant
 * to be included more than once.
 */

MMT_PROTO_SIMPLE(PROTO_163, PROTO_163_ALIAS, "proto_163")
MMT_PROTO_SIMPLE(PROTO_360, PROTO_360_ALIAS, "proto_360")
MMT_PROTO_SIMPLE(PROTO_ZONE_TELECHARGEMENT, PROTO_ZONE_TELECHARGEMENT_ALIAS, "PROTO_ZONE_TELECHARGEMENT")
