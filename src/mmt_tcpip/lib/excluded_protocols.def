/*
 * excluded_protocols.def — the protocol ids a flow can exclude (issue #561,
 * F-PERF-005 part 2 / F-PERF-105).
 *
 * One MMT_EXCLUDABLE(PROTO_X) row per protocol id a classifier writes to or
 * reads from a flow's exclusion set (MMT_EXCLUDE_PROTOCOL,
 * MMT_FLOW_EXCLUDES, MMT_FLOW_PROTOCOL_EXCLUDED) or that a checker's guard
 * names (the excluded_proto column of inter_proto_classif_list.def). The row
 * order gives each id its dense slot (MMT_EXCL_SLOT_<PROTO_X>), so the
 * session's exclusion set is MMT_EXCL_SET_WORDS 64-bit words instead of a
 * bit per protocol id (1,024 bits). A macro naming an id missing here does
 * not compile; add the row (any position — slots are internal).
 *
 * Not include-guarded: included with MMT_EXCLUDABLE defined by the includer.
 */
    MMT_EXCLUDABLE(PROTO_AFP)
    MMT_EXCLUDABLE(PROTO_AIMINI)
    MMT_EXCLUDABLE(PROTO_APPLEJUICE)
