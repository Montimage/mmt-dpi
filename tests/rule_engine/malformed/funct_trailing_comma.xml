<?xml version="1.0"?>
<!-- tests/rule_engine (#511/#512): an embedded-function call with a trailing comma (one parameter fewer than written was passed)
     run_tests.sh step 4 expects init_sec_lib() to return an error. -->
<beginning>
  <property value="THEN" property_id="1" description="funct_trailing_comma">
    <event event_id="1" description="A" boolean_expression="(#echo_port(UDP.dest_port,) == 1001)"/>
    <event event_id="2" description="B" boolean_expression="(UDP.dest_port == 1002)"/>
  </property>
</beginning>
