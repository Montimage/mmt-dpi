<?xml version="1.0"?>
<!-- tests/rule_engine (#510): A THEN AFTER B within [0, 2] s with keep_state="1": a verdict keeps A's state, so a later B is matched again without a new A.
     A = UDP.dest_port 1001, B = 1002, C = 1003; scenarios in test_rule_eval.c. -->
<beginning>
  <property value="THEN" property_id="20" type_property="SECURITY_RULE" description="keep_state" delay_units="s" delay_min="0" delay_max="2" keep_state="1">
    <event event_id="1" description="A" boolean_expression="(UDP.dest_port == 1001)"/>
    <event event_id="2" description="B" boolean_expression="(UDP.dest_port == 1002)"/>
  </property>
</beginning>
