<?xml version="1.0"?>
<!-- tests/rule_engine (#509): A frame (UDP.dest_port 1001) THEN, on the same packet (no delay or counter), a frame longer than 100 bytes.
     A = UDP.dest_port 1001, B = 1002, C = 1003; scenarios in test_rule_eval.c. -->
<beginning>
  <property value="THEN" property_id="1" type_property="SECURITY_RULE" description="then_same" >
    <event event_id="1" description="A" boolean_expression="(UDP.dest_port == 1001)"/>
    <event event_id="2" description="A is long" boolean_expression="(META.packet_len &gt; 100)"/>
  </property>
</beginning>
