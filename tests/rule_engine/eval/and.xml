<?xml version="1.0"?>
<!-- tests/rule_engine (#509): A THEN AFTER (B AND frame longer than 100 bytes) within [0, 2] s.
     A = UDP.dest_port 1001, B = 1002, C = 1003; scenarios in test_rule_eval.c. -->
<beginning>
  <property value="THEN" property_id="7" type_property="SECURITY_RULE" description="and" delay_units="s" delay_min="0" delay_max="2">
    <event event_id="1" description="A" boolean_expression="(UDP.dest_port == 1001)"/>
    <operator value="AND">
      <event event_id="2" description="B" boolean_expression="(UDP.dest_port == 1002)"/>
      <event event_id="3" description="long" boolean_expression="(META.packet_len &gt; 100)"/>
    </operator>
  </property>
</beginning>
