<?xml version="1.0"?>
<!-- tests/rule_engine (#511): A THEN AFTER B within [0, 2] s, both events
     computed by embedded functions from the libembedded_functions.so that
     run_tests.sh builds from embedded_functions.c — the symbols are
     resolved once, at load. B uses the four-parameter maximum. -->
<beginning>
  <property value="THEN" property_id="22" type_property="SECURITY_RULE" description="embedded_funct" delay_units="s" delay_min="0" delay_max="2">
    <event event_id="1" description="A" boolean_expression="(#echo_port(UDP.dest_port) == 1001)"/>
    <event event_id="2" description="B" boolean_expression="(#sum_ports(UDP.dest_port, 1, 2, 3) == 1008)"/>
  </property>
</beginning>
