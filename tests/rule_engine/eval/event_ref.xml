<?xml version="1.0"?>
<!-- tests/rule_engine (#509): A THEN AFTER a B frame as long as A (META.packet_len.1 event reference) within [0, 2] s.
     A = UDP.dest_port 1001, B = 1002, C = 1003; scenarios in test_rule_eval.c. -->
<beginning>
  <property value="THEN" property_id="10" type_property="SECURITY_RULE" description="event_ref" delay_units="s" delay_min="0" delay_max="2">
    <event event_id="1" description="A" boolean_expression="(UDP.dest_port == 1001)"/>
    <event event_id="2" description="B same len" boolean_expression="((UDP.dest_port == 1002)&amp;&amp;(META.packet_len == META.packet_len.1))"/>
  </property>
</beginning>
