<?xml version="1.0"?>
<!-- tests/rule_engine (#509): A seen twice (REPEAT, repeat_times = 2) THEN AFTER B within [0, 5] s.
     A = UDP.dest_port 1001, B = 1002, C = 1003; scenarios in test_rule_eval.c. -->
<beginning>
  <property value="THEN" property_id="16" type_property="SECURITY_RULE" description="repeat" delay_units="s" delay_min="0" delay_max="5">
    <operator value="REPEAT" repeat_times="2">
      <event event_id="1" description="A" boolean_expression="(UDP.dest_port == 1001)"/>
    </operator>
    <event event_id="2" description="B" boolean_expression="(UDP.dest_port == 1002)"/>
  </property>
</beginning>
