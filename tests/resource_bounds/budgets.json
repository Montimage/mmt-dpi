        { "id": "shuffled-accounted-small", "metric": "shuffled.n1024.offers", "op": "sum", "parts": ["shuffled.n1024.accepted", "shuffled.n1024.refused"] },
        { "id": "shuffled-accounted-large", "metric": "shuffled.n16384.offers", "op": "sum", "parts": ["shuffled.n16384.accepted", "shuffled.n16384.refused"] },
        { "id": "interleaved-full-small", "metric": "interleaved.n1024.refused", "op": "eq", "limit": 0 },
