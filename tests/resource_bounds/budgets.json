        { "id": "interleaved-visits-large", "metric": "interleaved.n16384.visits", "op": "lt", "limit": 67100672, "baseline": 67100672 },
        { "id": "tail-anchor-visits-small", "metric": "tail-anchor.n1024.visits", "op": "lt", "limit": 261632, "baseline": 261632 },
        { "id": "tail-anchor-visits-large", "metric": "tail-anchor.n16384.visits", "op": "lt", "limit": 67100672, "baseline": 67100672 },
        { "id": "shuffled-visits-small", "metric": "shuffled.n1024.visits", "op": "lt", "limit": 261632, "baseline": 261632 },
