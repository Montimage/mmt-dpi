        { "id": "no-refusal-large", "metric": "n16384.inserts_refused", "op": "eq", "limit": 0 },
        { "id": "lookups-small", "metric": "n1024.lookups_hit", "op": "eq", "limit_metric": "n1024.inputs" },
        { "id": "lookups-large", "metric": "n16384.lookups_hit", "op": "eq", "limit_metric": "n16384.inputs" },
        { "id": "comparator-small", "metric": "n1024.comparator_calls", "op": "lt", "limit": 751360, "baseline": 751360 },
        { "id": "comparator-large", "metric": "n16384.comparator_calls", "op": "lt", "limit": 200273920, "baseline": 200273920 },
        { "id": "comparator-growth", "metric": "n16384.comparator_calls", "op": "le", "factor": 24, "limit_metric": "n1024.comparator_calls" },
        { "id": "collision-per-op", "metric": "forced_collision.worst_op_comparator_calls", "op": "le", "limit_metric": "forced_collision.per_op_bound" },
        { "id": "saturated-refused", "metric": "saturated.inserts_offered", "op": "sum", "parts": ["saturated.inserts_refused"] },
        { "id": "saturated-bounded", "metric": "saturated.comparator_calls", "op": "le", "factor": 2, "limit_metric": "saturated.cap" },
        { "id": "checks", "metric": "checks.failed", "op": "eq", "limit": 0 }
