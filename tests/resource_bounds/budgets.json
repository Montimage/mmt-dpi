        { "id": "accounted-large", "metric": "n16384.inputs", "op": "sum", "parts": ["n16384.inserts_accepted", "n16384.inserts_refused"] },
        { "id": "no-refusal-small", "metric": "n1024.inserts_refused", "op": "eq", "limit": 0 },
