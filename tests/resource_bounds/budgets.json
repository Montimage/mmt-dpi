        { "id": "scale-small", "metric": "n1024.inputs", "op": "eq", "limit": 1024 },
        { "id": "scale-large", "metric": "n16384.inputs", "op": "eq", "limit": 16384 },
        { "id": "accounted-small", "metric": "n1024.inputs", "op": "sum", "parts": ["n1024.inserts_accepted", "n1024.inserts_refused"] },
        { "id": "accounted-large", "metric": "n16384.inputs", "op": "sum", "parts": ["n16384.inserts_accepted", "n16384.inserts_refused"] },
